<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOCAL STAND-IN, NOT the official Europass file. The official
  https://europass.cedefop.europa.eu/xml/imported/ISCED97_V1.0.0.xsd is no longer
  served and is not in github.com/europass/ewa-cedefop. Only the type referenced by
  EducationalExperience.xsd (isced:field-level2) is declared, as a two-digit
  ISCED-97 field code (e.g. "21" = Arts). The official file likely enumerates codes.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://europass.cedefop.europa.eu/ISCED/97"
            elementFormDefault="qualified">
  <xsd:simpleType name="field-level2">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[0-9]{2}"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
