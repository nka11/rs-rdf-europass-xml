<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOCAL STAND-IN, NOT the official Europass file. The official
  https://europass.cedefop.europa.eu/xml/imported/NACE_COM_V1.0.0.xsd is no longer
  served and is not in github.com/europass/ewa-cedefop. Only nace:sector-level1
  (referenced by Organisation.xsd) is declared, as a single NACE section letter A-U
  (the shipped example uses "Q"). The official file likely enumerates the sections.
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://europass.cedefop.europa.eu/NACE"
            elementFormDefault="qualified">
  <xsd:simpleType name="sector-level1">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[A-U]"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
